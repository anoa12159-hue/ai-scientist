    "tree_hash": { "$ref": "https://ai-scientist-mvp.invalid/contracts/shared/definitions.schema.json#/$defs/sha256" },
    "tree_hash_algorithm": { "type": "string" },
    "identity_authority": { "type": "string" },
    "authored_package_seal_status": { "type": "string" },
    "lineage_edges": {
