{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-scientist-mvp.invalid/contracts/artifact-runtime/artifact-ref.schema.json",
  "title": "ArtifactRef",
  "description": "Immutable Artifact reference: artifact_id + content_sha256 + schema_version. content_sha256 covers the authority content (raw bytes for SourceDocument, canonical payload otherwise). Frozen semantics: CONTRACTS.md 4.0.",
  "type": "object",
  "properties": {
    "artifact_id": { "type": "string" },
    "content_sha256": { "$ref": "https://ai-scientist-mvp.invalid/contracts/shared/definitions.schema.json#/$defs/sha256" },
    "schema_version": { "$ref": "https://ai-scientist-mvp.invalid/contracts/shared/definitions.schema.json#/$defs/schema_version" }
  },
  "required": ["artifact_id", "content_sha256", "schema_version"],
  "additionalProperties": false
}
