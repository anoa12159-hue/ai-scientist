{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-scientist-mvp.invalid/contracts/governance-release/authorization-record.schema.json",
  "title": "AuthorizationRecord",
  "description": "Capability-bound authorization. Authorization does not auto-carry over when content, configuration or workflow version changes. Frozen semantics: CONTRACTS.md 6.3.",
  "type": "object",
  "properties": {
    "authorization_id": { "type": "string" },
    "schema_version": { "$ref": "https://ai-scientist-mvp.invalid/contracts/shared/definitions.schema.json#/$defs/schema_version" },
    "content_hash": { "$ref": "https://ai-scientist-mvp.invalid/contracts/shared/definitions.schema.json#/$defs/content_hash" },
    "capability": { "$ref": "https://ai-scientist-mvp.invalid/contracts/shared/definitions.schema.json#/$defs/authorization_capability" },
    "authorization_status": { "$ref": "https://ai-scientist-mvp.invalid/contracts/shared/definitions.schema.json#/$defs/authorization_status" },
    "scope": { "type": "string" },
    "actor_id": { "type": "string" },
    "actor_role": { "type": "string" },
    "bound_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://ai-scientist-mvp.invalid/contracts/artifact-runtime/artifact-ref.schema.json" }
    },
    "configuration_ref": { "$ref": "https://ai-scientist-mvp.invalid/contracts/foundation/versioned-ref.schema.json" },
    "workflow_version": { "type": "string" },
    "created_at": { "$ref": "https://ai-scientist-mvp.invalid/contracts/shared/definitions.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "https://ai-scientist-mvp.invalid/contracts/shared/definitions.schema.json#/$defs/timestamp" },
    "supersedes_ref": { "$ref": "https://ai-scientist-mvp.invalid/contracts/foundation/versioned-ref.schema.json" }
  },
  "required": [
    "authorization_id", "schema_version", "content_hash", "capability",
    "authorization_status", "scope", "actor_id", "actor_role",
    "bound_artifact_refs", "configuration_ref", "workflow_version", "created_at"
  ],
  "additionalProperties": false
}
